# Arc Sentinel — environment template (SPEC §6, §11.1)
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://arc_sentinel:arc_sentinel@localhost:5432/arc_sentinel

# --- Indexer (defaults point at Arc Testnet, chain 5042002) ---------------
#
# ARC MAINNET IS LIVE (chain 5042). For production use Alchemy mainnet:
#   RPC_URL=https://arc-mainnet.g.alchemy.com/v2/<YOUR_API_KEY>
#   CHAIN_ID=5042
# Create app at https://dashboard.alchemy.com/signup (network: Arc Mainnet)
# Verified 2026-09-16: chainId=5042, head≈21.2M blocks, USDC=0x3600...0000 dec=6.
#
# For local dev / CI keep Testnet (free faucet, no real money):
#   RPC_URL=https://rpc.testnet.arc.io   CHAIN_ID=5042002
RPC_URL=https://rpc.testnet.arc.io
CHAIN_ID=5042002
POLL_INTERVAL_SECONDS=3.0
CONFIRMATIONS=2

# --- API ------------------------------------------------------------------
# sha256 hex of the write-scope X-API-Key (empty => write endpoints disabled)
API_KEY_HASH=

# --- Postgres container (docker-compose.yml) ------------------------------
POSTGRES_USER=arc_sentinel
POSTGRES_PASSWORD=arc_sentinel
POSTGRES_DB=arc_sentinel