# Arc Sentinel — environment template (SPEC §6, §11.1, §11.4)
# Copy to `.env` and fill in real values. NEVER commit `.env` (gitignored).
#
# Credentials & Secrets Map (full table in SPEC §11.4):
#   GitHub Secrets are the SOURCE of truth -> deploy.yml writes them into VM .env.
#   Your local .env uses fake/dummy values for dev; VM .env holds real values.

# --- Database -------------------------------------------------------------
# Local dev fake values are fine. Real ones: GitHub Secrets -> VM .env.
DATABASE_URL=postgresql+psycopg://arc_sentinel:arc_sentinel@localhost:5432/arc_sentinel

# --- Indexer (defaults point at Arc Testnet, chain 5042002) ---------------
#
# ARC MAINNET IS LIVE (chain 5042). For production use Alchemy mainnet:
#   RPC_URL=https://arc-mainnet.g.alchemy.com/v2/<YOUR_API_KEY>
#   CHAIN_ID=5042
# Create app at https://dashboard.alchemy.com/signup (network: Arc Mainnet)
# Verified 2026-09-16: chainId=5042, head≈21.2M blocks, USDC=0x3600...0000 dec=6.
#
# For local dev / CI keep Testnet (free faucet, no real money):
#   RPC_URL=https://rpc.testnet.arc.io   CHAIN_ID=5042002
#
# Two Alchemy apps under the same account (see SPEC §11.4):
#   ARC_MAINNET_RPC_URL — used in VM .env (production)
#   ARC_TESTNET_RPC_URL — used by CI integration tests
RPC_URL=https://rpc.testnet.arc.io
CHAIN_ID=5042002
POLL_INTERVAL_SECONDS=3.0
CONFIRMATIONS=2

# --- API ------------------------------------------------------------------
# sha256 hex of the write-scope X-API-Key (empty => write endpoints disabled)
# Generate key -> hash locally, keep the plaintext key in your password manager:
#   KEY=$(openssl rand -hex 24)
#   printf '%s' "$KEY" | sha256sum   # paste result into API_KEY_HASH below
API_KEY_HASH=

# --- Postgres container (docker-compose.yml) ------------------------------
# Real values in VM .env (written by deploy.yml from GitHub Secrets).
# Local dev fake values are fine.
POSTGRES_USER=arc_sentinel
POSTGRES_PASSWORD=arc_sentinel
POSTGRES_DB=arc_sentinel

# --- Deployment (GitHub Actions Secrets, NOT here) -------------------------
# The following NEVER go into .env / repo; they live in GitHub Secrets and
# deploy.yml writes the derived values into the VM's .env:
#   DEPLOY_SSH_PRIVATE_KEY / DEPLOY_HOST / DEPLOY_USER   (SSH into VM)
#   DUCKDNS_TOKEN                                        (VM-only cron)
#   OCI Object Storage keys                              (VM-only backup)
#   CIRCLE_API_KEY                                       (only if §16-4 adopted)