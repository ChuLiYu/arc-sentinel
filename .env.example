# Copy to .env.local for the local stack, or .env.production on a pilot host.
# Never commit filled-in files. No private keys or funded wallet are required.
POSTGRES_USER=sentinel
POSTGRES_DB=sentinel
# LOCAL DEVELOPMENT ONLY. Replace with a generated hex value for a pilot.
POSTGRES_PASSWORD=local-development-only
RPC_URL=https://rpc.testnet.arc.io
RPC_FALLBACK_URL=
CHAIN_ID=5042002
USDC_ADDRESS=0x3600000000000000000000000000000000000000
CONFIRMATIONS=2
POLL_INTERVAL_SECONDS=3
RPC_LOGS_MAX_RANGE_SIZE=10
MAX_BLOCKS_PER_CYCLE=80
REORG_MAX_DEPTH=64
# Optional inclusive start for a NEW checkpoint. Check RPC history availability.
# START_BLOCK=123456
# Set with openssl rand -hex 32 before issuing API keys.
SENTINEL_API_KEY_SALT=
API_KEY_HASH=
# Pilot only: DNS hostname and tested image, configured before starting Compose.
# ARC_SENTINEL_DOMAIN=sentinel.example.com
# SENTINEL_IMAGE=ghcr.io/chuliyu/arc-sentinel:<tested-full-commit-sha>
# Legacy ARC_MAINNET_RPC_URL aliases override RPC_URL: remove them for testnet.
